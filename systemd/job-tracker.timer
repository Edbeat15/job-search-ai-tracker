# Installed timer unit is generated by script/install_job_tracker_timer.sh.
# JOB_TRACKER_SCHEDULE is read from config/local.sh (default: 09:00 daily).
[Unit]
Description=Run the Local AI Job Application Tracker daily

[Timer]
# OnCalendar is generated dynamically by the installer.
Persistent=false
AccuracySec=1min
Unit=job-tracker.service

[Install]
WantedBy=timers.target
